/**
 * Δημιουργία της Google Form του Analyst Report Pack (MSc Thesis, RQ3 human baseline).
 *
 * ΧΡΗΣΗ
 *   1. Συνδέσου στο Google με τον λογαριασμό που θα φιλοξενεί τη φόρμα
 *   2. Άνοιξε https://script.google.com  ->  Νέο έργο
 *   3. Σβήσε ό,τι υπάρχει, επικόλλησε ΟΛΟ αυτό το αρχείο
 *   4. Τρέξε τη συνάρτηση createAnalystForm (Run)
 *   5. Δώσε τις άδειες που ζητά, και δες το URL στο Execution log
 *   6. Προαιρετικά, ανέβασε δική σου εικόνα κεφαλίδας χειροκίνητα (δεν υπάρχει API γι' αυτήν):
 *      εικονίδιο παλέτας πάνω δεξιά -> Κεφαλίδα -> Μεταφόρτωση.
 *   7. Στις Ρυθμίσεις, επιβεβαίωσε ότι "Συλλογή διευθύνσεων email" και "Περιορισμός σε
 *      1 απάντηση" είναι ΑΝΕΝΕΡΓΑ.
 *
 * Το script ρυθμίζει ρητά: collectEmail = false (καμία καταγραφή ταυτότητας),
 * limitOneResponsePerUser = false (δεν απαιτείται σύνδεση), allowResponseEdits = false.
 *
 * ΤΑΥΤΟΠΟΙΗΣΗ: η υποβολή είναι ανώνυμη. Ο συμμετέχων δηλώνει ΜΟΝΟΣ του έναν κωδικό απόσυρσης
 * (μορφή AAA999), ο οποίος χρησιμεύει αποκλειστικά για την άσκηση του δικαιώματος απόσυρσης.
 * Οι κωδικοί επεξεργασίας A1..A5 αποδίδονται από τον ερευνητή ΕΚ ΤΩΝ ΥΣΤΕΡΩΝ, κατά τη
 * χρονοσήμανση υποβολής.
 *
 * Πηγή δεδομένων: AdventureWorks internet sales, locked snapshot, source CSV hash b55cbddf5950.
 * Οι τιμές είναι αντιγραμμένες αυτούσια από το κλειδωμένο Analyst_Report_Pack.docx.
 */

function createAnalystForm() {

  var form = FormApp.create('Σύνταξη Επιχειρησιακών Αναφορών - Μεταπτυχιακή Έρευνα');

  form.setDescription(
    'Ευχαριστώ θερμά που αφιερώνετε λίγο από τον χρόνο σας.\n\n'
    + 'Η έρευνα αυτή εξετάζει κατά πόσο συστήματα τεχνητής νοημοσύνης μπορούν να παράγουν '
    + 'επιχειρησιακές αναφορές συγκρίσιμης ποιότητας με αναφορές που συντάσσουν άνθρωποι '
    + 'αναλυτές, στο πλαίσιο μεταπτυχιακής διατριβής στο πρόγραμμα σπουδών MSc in Artificial '
    + 'Intelligence του University of Essex. Θα σας ζητηθεί να γράψετε τρεις σύντομες αναφορές '
    + 'με βάση έτοιμα δεδομένα πωλήσεων. Η συμμετοχή σας είναι εθελοντική και ανώνυμη και '
    + 'διαρκεί περίπου 30–45 λεπτά. Τα δεδομένα θα χρησιμοποιηθούν αποκλειστικά για '
    + 'ακαδημαϊκούς σκοπούς.\n\n'
    + 'Το Έντυπο Ενημέρωσης είναι διαθέσιμο εδώ: '
    + '<INFO_SHEET_URL>'   // replace with the link to YOUR approved Information Sheet
  );

  form.setCollectEmail(false);
  form.setLimitOneResponsePerUser(false);
  form.setAllowResponseEdits(false);
  form.setProgressBar(true);
  form.setShowLinkToRespondAgain(false);
  form.setConfirmationMessage(
    'Έτοιμο, η υποβολή καταγράφηκε. Σας ευχαριστώ πολύ για τον χρόνο και τη βοήθειά σας.\n\n'
    + 'Υπενθύμιση: διατηρείτε το δικαίωμα απόσυρσης των δεδομένων σας έως και τέσσερις (4) '
    + 'εβδομάδες από την υποβολή, με ένα email στον ερευνητή αναφέροντας τον κωδικό απόσυρσης '
    + 'που δηλώσατε. Κρατήστε τον σημειωμένο.'
  );

  var statements = [
    'Έχω ενημερωθεί πλήρως για τη φύση και τους σκοπούς της έρευνας, όπως αναγράφονται στο έντυπο ενημέρωσης.',
    'Επιθυμώ να λάβω μέρος στην έρευνα.',
    'Κατανοώ ότι έχω το δικαίωμα να αποσυρθώ από την έρευνα σε οποιαδήποτε στιγμή, χωρίς να αποκαλύψω τους λόγους.',
    'Σε περίπτωση που επιθυμώ να αποσύρω τα αποτελέσματά μου, μετά το πέρας της εξέτασης, έχω χρονικό περιθώριο έως τέσσερεις (4) εβδομάδες.',
    'Δίνω την άδειά μου να χρησιμοποιηθούν ανωνυμοποιημένα αποσπάσματα από τις αναφορές μου στη διατριβή και σε πιθανές δημοσιεύσεις, χωρίς αναφορά του ονόματός μου.',
    'Κατανοώ ότι οι πληροφορίες που θα συλλεχθούν θα αποθηκευτούν σε ασφαλές μέρος, για όσο διάστημα κριθεί απαραίτητο από τους/τις Ερευνητές/Ερευνήτριες.',
    'Κατανοώ ότι, πέραν του Ερευνητή και του Επόπτη του, τις αναφορές μου θα διαβάσει και θα βαθμολογήσει ανεξάρτητη ομάδα αξιολογητών, αποκλειστικά σε ανωνυμοποιημένη μορφή και χωρίς να γνωρίζουν την ταυτότητά μου.',
    'Κατανοώ ότι όλες οι πληροφορίες που παρέχω κατά τη διάρκεια της έρευνας θα παραμείνουν εμπιστευτικές.'
  ];

  var decl = form.addCheckboxItem()
    .setTitle('Δηλώσεις συγκατάθεσης')
    .setHelpText('Παρακαλώ σημειώστε ότι συμφωνείτε με καθεμία από τις παρακάτω δηλώσεις.')
    .setChoiceValues(statements)
    .setRequired(true);

  decl.setValidation(
    FormApp.createCheckboxValidation()
      .setHelpText('Για να συμμετάσχετε, πρέπει να συμφωνείτε με όλες τις δηλώσεις.')
      .requireSelectExactly(statements.length)
      .build()
  );

  var codeItem = form.addTextItem()
    .setTitle('Κωδικός απόσυρσης (τον επιλέγετε εσείς)')
    .setHelpText(
      'Τρία λατινικά ΚΕΦΑΛΑΙΑ γράμματα και τρία ψηφία, για παράδειγμα ROM742. Προτείνεται: τα '
      + 'τρία πρώτα γράμματα μιας πόλης που σας αρέσει και ένας τριψήφιος αριθμός που θα '
      + 'θυμάστε.\n\n'
      + 'Ο κωδικός χρησιμεύει μόνο για να μπορέσετε να αποσύρετε τα δεδομένα σας εντός τεσσάρων '
      + '(4) εβδομάδων, στέλνοντάς τον με email στον ερευνητή. Δεν σας ταυτοποιεί και δεν '
      + 'συνδέεται με το όνομά σας.\n\n'
      + 'Μην χρησιμοποιήσετε όνομα, αρχικά, ημερομηνία γέννησης, τηλέφωνο, αριθμό μητρώου ή την '
      + 'πόλη στην οποία ζείτε.'
    )
    .setRequired(true);

  codeItem.setValidation(
    FormApp.createTextValidation()
      .setHelpText('Μορφή: 3 λατινικά ΚΕΦΑΛΑΙΑ γράμματα και 3 ψηφία, π.χ. ROM742.')
      .requireTextMatchesPattern('^[A-Z]{3}[0-9]{3}$')
      .build()
  );

  form.addSectionHeaderItem()
    .setTitle('Πώς να απαντήσετε (ισχύει για όλα τα σενάρια)')
    .setHelpText(
      '\u00A0\n'
      + 'Κάθε σενάριο έχει 3 συγκεκριμένα ερωτήματα. Απαντήστε και στα τρία μέσα σε ενιαία, ρέουσα '
      + 'πρόζα ~150–250 λέξεων, με προτεραιότητα στην πληρότητα και τη σαφήνεια και όχι στην '
      + 'επίτευξη συγκεκριμένου αριθμού λέξεων, χωρίς επικεφαλίδες ή λίστες. Τα ερωτήματα ορίζουν '
      + 'το αναλυτικό έργο, όχι τη μορφή της αναφοράς.\n\n'
      + 'Δεδομένα και υπολογισμοί: Χρησιμοποιήστε τις παρεχόμενες τιμές ως έχουν. Επιτρέπεται να '
      + 'πραγματοποιήσετε απλούς υπολογισμούς που προκύπτουν άμεσα από αυτές (απόλυτες διαφορές, '
      + 'ποσοστιαίες μεταβολές, μερίδια). Δεν επιτρέπεται η χρήση εξωτερικών δεδομένων, '
      + 'εκτιμήσεων ή μη τεκμηριωμένων παραδοχών.\n\n'
      + 'Παρατήρηση και ερμηνεία: Διακρίνετε σαφώς την παρατήρηση από την ερμηνεία. Οι τιμές, οι '
      + 'διαφορές και οι υπολογισμένες μεταβολές πρέπει να στηρίζονται στα δεδομένα, κάθε '
      + 'ερμηνεία ή πιθανή εξήγηση διατυπώνεται ως υπόθεση. Μη γράφετε «λόγω X» αν το X δεν '
      + 'προκύπτει από τα δεδομένα.\n\n'
      + 'Ουδετερότητα: το συμπέρασμα είναι δικό σας, αρκεί να στηρίζεται στα δεδομένα. Τα '
      + 'ερωτήματα κατευθύνουν την ανάλυση, δεν προδικάζουν την απάντηση.\n\n'
      + 'Ύφος: επαγγελματικό και ουδέτερο. Αποδώστε τα μεγέθη με κανονικές λέξεις (π.χ. «τα '
      + 'συνολικά έσοδα»), όχι με ονόματα KPI.'
    );

  form.addSectionHeaderItem()
    .setTitle('Φυσικότητα γραφής')
    .setHelpText(
      '\u00A0\n'
      + 'Η αναφορά πρέπει να διαβάζεται σαν κείμενο που θα έγραφε φυσικά ένας επαγγελματίας '
      + 'business analyst. Αποφύγετε τυποποιημένες ή υπερβολικά «γυαλισμένες» διατυπώσεις, '
      + 'επαναλαμβανόμενα μοτίβα προτάσεων και περιττές μεταβατικές φράσεις. Προτιμήστε απλές, '
      + 'φυσικές ελληνικές προτάσεις και άμεσο επαγγελματικό ύφος.\n\n'
      + 'Χρησιμοποιήστε κανονική ελληνική στίξη, κυρίως κόμματα και τελείες. Μη χρησιμοποιείτε '
      + 'παύλες (em dash) ως στιλιστικό εργαλείο και αποφύγετε την υπερβολική χρήση άνω και κάτω '
      + 'τελείας, παρενθέσεων, bullets ή άλλων μορφοποιητικών στοιχείων μέσα στην αναφορά.\n\n'
      + 'Μην επιχειρείτε να κάνετε το κείμενο τεχνητά «ανθρώπινο» μέσω λαθών, αδέξιας ή '
      + 'υπερβολικά χαλαρής διατύπωσης. Η φυσικότητα προκύπτει από καθαρή, απλή και συνεπή '
      + 'επαγγελματική γραφή.\n\n'
      + 'Μια πρακτική συμβουλή: η φόρμα δεν αποθηκεύει αυτόματα προσχέδια. Συνθέστε το κείμενο σε '
      + 'επεξεργαστή κειμένου και κάντε επικόλληση εδώ.'
    );

  form.addSectionHeaderItem()
    .setTitle('Σύντομο γλωσσάρι KPI')
    .setHelpText(
      '\u00A0\n'
      + 'Συνολικά Έσοδα: Αξία όλων των πωλήσεων της περιόδου (μονάδες × τιμή μονάδας).\n'
      + 'Ρυθμός Μεταβολής Εσόδων (MoM): Ποσοστιαία μεταβολή εσόδων vs τον προηγούμενο μήνα.\n'
      + 'Μέση Αξία Παραγγελίας (AOV): Συνολικά έσοδα ÷ αριθμός διακριτών παραγγελιών.\n'
      + 'Μεικτό Περιθώριο %: Ποσοστό εσόδων που απομένει μετά το κόστος πωληθέντων (μικτό κέρδος).\n'
      + 'Έσοδα ανά Περιοχή/Κατηγορία: Κατανομή εσόδων ανά χώρα ή κατηγορία προϊόντων.\n'
      + 'Κορυφαία Προϊόντα: Προϊόντα με τη μεγαλύτερη συνεισφορά στα έσοδα (ο αριθμός σε '
      + 'παρένθεση, π.χ. «μέγεθος 38», δηλώνει το μέγεθος πλαισίου του ποδηλάτου).\n\n'
      + 'Τα δεδομένα δεν περιλαμβάνουν επιστροφές (returns).'
    );

  addScenario(form, {
    page: 'Σενάριο 1: Συνολική επίδοση περιόδου',
    period: '2013-12',
    data: [
      ['Συνολικά έσοδα', '1,874,360.29 €'],
      ['Ρυθμός μεταβολής εσόδων (MoM)', '5.25%'],
      ['Συνολικές μονάδες', '5520 units'],
      ['Μέση αξία παραγγελίας (AOV)', '855.09 €'],
      ['Μεικτό περιθώριο %', '41.41%'],
      ['Έσοδα προηγούμενης περιόδου (Νοέμβριος 2013)', '1,780,920.06 €']
    ],
    questions: [
      'Ποια είναι η συνολική εικόνα εσόδων και όγκου πωλήσεων τον Δεκέμβριο 2013;',
      'Πώς συγκρίνεται η επίδοση με τον προηγούμενο μήνα (μέγεθος και κατεύθυνση της μεταβολής);',
      'Τι δείχνουν η μέση αξία παραγγελίας και το μεικτό περιθώριο για την επίδοση της περιόδου;'
    ]
  });

  addScenario(form, {
    page: 'Σενάριο 2: Κατανομή εσόδων ανά περιοχή και κατηγορία',
    period: '2013-12',
    data: [
      ['Συνολικά έσοδα (Δεκέμβριος 2013) - βάση για μερίδια', '1,874,360.29 €'],
      ['Έσοδα – Αυστραλία', '463,135.17 €'],
      ['Έσοδα – Καναδάς', '128,157.71 €'],
      ['Έσοδα – Γαλλία', '190,580.53 €'],
      ['Έσοδα – Γερμανία', '203,760.82 €'],
      ['Έσοδα – Ηνωμένο Βασίλειο', '250,632.09 €'],
      ['Έσοδα – Ηνωμένες Πολιτείες', '638,093.97 €'],
      ['Έσοδα – Αξεσουάρ', '65,783.35 €'],
      ['Έσοδα – Ποδήλατα', '1,773,771.81 €'],
      ['Έσοδα – Ένδυση', '34,805.13 €'],
      ['Κορυφαίο προϊόν 1 – Mountain-200 Silver (μέγεθος 38)', '139,199.40 €'],
      ['Κορυφαίο προϊόν 2 – Mountain-200 Black (μέγεθος 42)', '126,224.45 €'],
      ['Κορυφαίο προϊόν 3 – Mountain-200 Silver (μέγεθος 42)', '120,639.48 €']
    ],
    questions: [
      'Πώς κατανέμονται τα έσοδα ανά κατηγορία; Υπολογίστε το μερίδιο κάθε κατηγορίας επί των '
        + 'συνολικών εσόδων και αναδείξτε ποιες έχουν τη μεγαλύτερη και τη μικρότερη συνεισφορά.',
      'Πώς κατανέμονται τα έσοδα ανά περιοχή; Με βάση τα μερίδια, ποιες περιοχές ξεχωρίζουν '
        + 'θετικά ή αρνητικά;',
      'Ποια προϊόντα συνεισφέρουν περισσότερο στα έσοδα;'
    ]
  });

  addScenario(form, {
    page: 'Σενάριο 3: Μεταβολή εσόδων Νοεμβρίου προς Δεκέμβριο 2013',
    period: '2013-12',
    data: [
      ['Συνολικά έσοδα', '1,874,360.29 €'],
      ['Ρυθμός μεταβολής εσόδων (MoM)', '5.25%'],
      ['Έσοδα – Αξεσουάρ', '65,783.35 €'],
      ['Έσοδα – Ποδήλατα', '1,773,771.81 €'],
      ['Έσοδα – Ένδυση', '34,805.13 €'],
      ['Έσοδα προηγούμενης περιόδου (Νοέμβριος 2013)', '1,780,920.06 €'],
      ['Έσοδα Νοεμβρίου 2013 – Ποδήλατα', '1,683,498.03 €'],
      ['Έσοδα Νοεμβρίου 2013 – Αξεσουάρ', '67,267.69 €'],
      ['Έσοδα Νοεμβρίου 2013 – Ένδυση', '30,154.34 €']
    ],
    questions: [
      'Πώς μεταβλήθηκαν τα συνολικά έσοδα από τον Νοέμβριο στον Δεκέμβριο 2013 (μέγεθος και '
        + 'κατεύθυνση);',
      'Σε ποιες κατηγορίες εντοπίζονται οι μεγαλύτερες μεταβολές (θετικές/αρνητικές);',
      'Ποια κατηγορία παρουσιάζει τη μεγαλύτερη απόλυτη μεταβολή και πόσο συμβάλλει αυτή η '
        + 'μεταβολή στη συνολική μεταβολή των εσόδων;'
    ]
  });

  Logger.log('ΦΟΡΜΑ (επεξεργασία): ' + form.getEditUrl());
  Logger.log('ΦΟΡΜΑ (αποστολή στους αναλυτές): ' + form.getPublishedUrl());
  return form.getPublishedUrl();
}

function addScenario(form, s) {
  form.addPageBreakItem().setTitle(s.page);
  var lines = s.data.map(function (row) { return '• ' + row[0] + ': ' + row[1]; }).join('\n');

  form.addSectionHeaderItem()
    .setTitle('Διαθέσιμα δεδομένα (χρησιμοποιήστε ακριβώς αυτές τις τιμές)')
    .setHelpText('\u00A0\n' + 'Περίοδος: ' + s.period + '\n\n' + lines);

  var qs = s.questions.map(function (q, i) { return (i + 1) + '. ' + q; }).join('\n');

  var item = form.addParagraphTextItem()
    .setTitle('Η αναφορά σας (~150–250 λέξεις, ενιαίο κείμενο)')
    .setHelpText(
      'Απαντήστε και στα τρία ερωτήματα, μέσα σε ενιαίο κείμενο, όχι σε ξεχωριστές ενότητες:\n\n'
      + qs + '\n\n'
      + 'Γράψτε την αναφορά σας σε ενιαία πρόζα, χωρίς επικεφαλίδες, λίστες ή αρίθμηση, και '
      + 'χωρίς να αναφέρετε το όνομά σας.'
    )
    .setRequired(true);

  var v = FormApp.createParagraphTextValidation()
    .setHelpText('Η αναφορά φαίνεται πολύ σύντομη. Αναμένονται περίπου 150–250 λέξεις.')
    .requireTextLengthGreaterThanOrEqualTo(600)
    .build();
  item.setValidation(v);
}
